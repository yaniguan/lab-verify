{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaniguan/lab-verify/schema/candidates.schema.json",
  "title": "LabVerifyCandidatesBenchmark",
  "description": "Strict schema for SQL verification benchmark items and labeled candidates.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["qid", "question", "gold", "candidates"],
    "properties": {
      "qid": { "type": "integer", "minimum": 1 },
      "question": { "type": "string", "minLength": 1 },
      "gold": { "type": "string", "minLength": 1 },
      "candidates": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["label", "sql"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "sql": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
